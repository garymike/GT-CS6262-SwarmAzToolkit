# Example output of deploy.ps1 (no real secrets). Reconcile var NAMES with the VM's provided .env.
AZURE_API_KEY=<your-key>
AZURE_API_BASE=https://<account>.openai.azure.com/
AZURE_API_VERSION=2024-10-21

# Reference models as azure/<deployment-name> in CrewAI:
SWARM_GRADING_MODEL=azure/gpt-5-nano
SWARM_DEV_MODEL=azure/gpt-4o-mini
